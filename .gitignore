# --- Run output ------------------------------------------------------------
# Generated tree-explorations from running the skill. Each run writes to
# <out>/<UTCdate>__<root-slug>/; these are the shipped defaults, one per
# command wrapper plus tree-chain's. They contain user content — never commit.
# tools/_i18n.py's is_skipped() also skips any TOP-LEVEL *-out/ directory, so
# a custom --out at the repo root stays invisible to the validator too.
tree-out/
brainstorm-out/
attack-out/
design-out/
code-audit-out/
chain-out/

# --- Agent / tooling state (per-machine, regenerable) ----------------------
# CLAUDE.md is shared (working principles); CLAUDE.local.md is for paths,
# virtualenvs, machine quirks — never commit it.
CLAUDE.local.md
# cc-memory plugin local state (sqlite + private conversation notes + indexes).
memory/
# cc-enforcer session state.
.ce/
# Claude Code per-machine settings (settings.local.json). Shared settings, if
# any are ever added, would need an explicit negation below.
.claude/

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Build / log artefacts -------------------------------------------------
*.log
*.tmp
# cc-memory state: machine-local, never content
.ccm/
